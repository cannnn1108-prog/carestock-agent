# Copy to .env (never commit .env). Leave values empty to run fully in mock mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live. This project is built and tested for sandbox only.
PAYPAL_ENV=sandbox
# Optional: enables Claude to explain and fine-tune the draft. Rules still decide the limits.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
PORT=3000
BASE_URL=http://localhost:3000
